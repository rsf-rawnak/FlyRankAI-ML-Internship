      "source": [
        "# Top Logistic Regression coefficient magnitudes\n",
        "feature_names = (\n",
        "    num_features\n",
        "    + list(log_reg.named_steps[\"prep\"]\n",
        "           .named_transformers_[\"cat\"]\n",
        "           .get_feature_names_out(cat_features))\n",
        ")\n",
        "\n",
        "coefs = log_reg.named_steps[\"clf\"].coef_[0]\n",
        "coef_table = (\n",
        "    pd.DataFrame({\"feature\": feature_names, \"coef\": coefs})\n",
        "    .sort_values(\"coef\", key=lambda s: s.abs(), ascending=False)\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "print(\"Top Logistic Regression coefficients by absolute magnitude:\")\n",
        "display(coef_table)\n",
        "\n",
        "# Simple test-set error review for Logistic Regression\n",
        "test_scored = df_test.copy()\n",
        "test_scored[\"model_probability\"] = logreg_scores\n",
        "test_scored[\"model_pred\"] = (logreg_scores >= 0.5).astype(int)\n",
        "\n",
        "false_positives = (\n",
        "    test_scored[test_scored[\"model_pred\"].eq(1) & test_scored[\"is_declining_label\"].eq(0)]\n",
        "    .sort_values(\"model_probability\", ascending=False)\n",
        "    .head(2)\n",
        ")\n",
        "false_negatives = (\n",
        "    test_scored[test_scored[\"model_pred\"].eq(0) & test_scored[\"is_declining_label\"].eq(1)]\n",
        "    .sort_values(\"model_probability\")\n",
        "    .head(2)\n",
        ")\n",
        "\n",
        "review_cols = [\n",
        "    \"content_id\", \"model_probability\", \"is_declining_label\",\n",
        "    \"days_since_last_update\", \"avg_position\", \"ctr\", \"engagement_rate\",\n",
        "]\n",
        "\n",
        "print(\"False positives:\")\n",
        "display(false_positives[review_cols])\n",
        "\n",
        "print(\"False negatives:\")\n",
        "display(false_negatives[review_cols])\n"
      ]
    },
