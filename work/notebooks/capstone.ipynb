      "source": [
        "from sklearn.model_selection import GroupShuffleSplit\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import roc_auc_score, average_precision_score\n",
        "\n",
        "# Feature engineering from W05/W07\n",
        "df[\"has_search_volume\"] = df[\"search_volume\"].notna().astype(int)\n",
        "df[\"has_word_count\"] = df[\"word_count\"].notna().astype(int)\n",
        "df[\"has_avg_position\"] = (df[\"avg_position\"] > 0).astype(int)\n",
        "\n",
        "df[\"log_impressions_90d\"] = np.log1p(df[\"impressions_90d\"])\n",
        "df[\"log_clicks_90d\"] = np.log1p(df[\"clicks_90d\"])\n",
        "df[\"log_sessions_90d\"] = np.log1p(df[\"sessions_90d\"])\n",
        "\n",
        "for c in [\"search_volume\", \"competition\", \"cpc\", \"word_count\", \"char_count\", \"scroll_rate\"]:\n",
        "    df[c] = df[c].fillna(df[c].median())\n",
        "\n",
        "# avg_position == 0 means \"no recorded position\", not rank zero.\n",
        "df[\"avg_position_filled\"] = df[\"avg_position\"].replace(0, 100)\n",
        "\n",
        "num_features = [\n",
        "    \"search_volume\", \"competition\", \"cpc\", \"word_count\", \"char_count\",\n",
        "    \"content_age_days\", \"days_since_last_update\", \"ctr\", \"avg_position_filled\",\n",
        "    \"engagement_rate\", \"scroll_rate\", \"ai_traffic_pct\",\n",
        "    \"has_search_volume\", \"has_word_count\", \"has_avg_position\",\n",
        "    \"log_impressions_90d\", \"log_clicks_90d\", \"log_sessions_90d\",\n",
        "]\n",
        "cat_features = [\"content_type\", \"main_intent\", \"competition_level\", \"age_tier\", \"freshness_tier\"]\n",
        "\n",
        "leaked_cols = {\n",
        "    \"trend_direction\", \"trend_pct\",\n",
        "    \"impressions_last_30d\", \"clicks_last_30d\", \"sessions_last_30d\",\n",
        "    \"impressions_prev_30d\", \"clicks_prev_30d\", \"sessions_prev_30d\",\n",
        "    \"is_declining_label\",\n",
        "}\n",
        "feature_cols = set(num_features + cat_features)\n",
        "assert not (feature_cols & leaked_cols), f\"Leak check failed: {feature_cols & leaked_cols}\"\n",
        "\n",
        "X = df[num_features + cat_features].copy()\n",
        "y = df[\"is_declining_label\"].copy()\n",
        "groups = df[\"client_id\"].copy()\n",
        "\n",
        "gss = GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=42)\n",
        "train_idx, test_idx = next(gss.split(X, y, groups=groups))\n",
        "\n",
        "X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]\n",
        "y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]\n",
        "df_test = df.iloc[test_idx].copy()\n",
        "\n",
        "overlap = set(groups.iloc[train_idx]) & set(groups.iloc[test_idx])\n",
        "assert len(overlap) == 0, f\"Client leakage detected: {overlap}\"\n",
        "\n",
        "preprocess = ColumnTransformer([\n",
        "    (\"num\", StandardScaler(), num_features),\n",
        "    (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), cat_features),\n",
        "])\n",
        "\n",
        "log_reg = Pipeline([\n",
        "    (\"prep\", preprocess),\n",
        "    (\"clf\", LogisticRegression(max_iter=1000, random_state=42)),\n",
        "])\n",
        "\n",
        "rand_forest = Pipeline([\n",
        "    (\"prep\", preprocess),\n",
        "    (\"clf\", RandomForestClassifier(\n",
        "        n_estimators=300,\n",
        "        max_depth=8,\n",
        "        min_samples_leaf=20,\n",
        "        random_state=42,\n",
        "        n_jobs=-1,\n",
        "    )),\n",
        "])\n",
        "\n",
        "log_reg.fit(X_train, y_train)\n",
        "rand_forest.fit(X_train, y_train)\n",
        "\n",
        "def precision_at_k(scores, labels, k=50):\n",
        "    order = np.argsort(-np.asarray(scores))\n",
        "    return float(np.asarray(labels)[order[:k]].mean())\n",
        "\n",
        "K = 50\n",
        "\n",
        "# Same baseline rule, same held-out rows\n",
        "stale_flag = (df_test[\"days_since_last_update\"] >= 90).astype(int)\n",
        "ctr_weak_flag = (\n",
        "    (df_test[\"avg_position\"] > 0)\n",
        "    & (df_test[\"avg_position\"] <= 20)\n",
        "    & (df_test[\"ctr\"] < 0.30)\n",
        ").astype(int)\n",
        "visible_flag = (df_test[\"impressions_90d\"] >= 250).astype(int)\n",
        "\n",
        "baseline_scores = (\n",
        "    visible_flag\n",
        "    * (1 + stale_flag + ctr_weak_flag)\n",
        "    * np.log1p(df_test[\"impressions_90d\"])\n",
        ")\n",
        "\n",
        "logreg_scores = log_reg.predict_proba(X_test)[:, 1]\n",
        "rf_scores = rand_forest.predict_proba(X_test)[:, 1]\n",
        "\n",
        "results = pd.DataFrame({\n",
        "    \"method\": [\"Week-4 rule baseline\", \"Logistic Regression\", \"Random Forest\"],\n",
        "    \"precision@50\": [\n",
        "        precision_at_k(baseline_scores, y_test, K),\n",
        "        precision_at_k(logreg_scores, y_test, K),\n",
        "        precision_at_k(rf_scores, y_test, K),\n",
        "    ],\n",
        "    \"roc_auc\": [\n",
        "        roc_auc_score(y_test, baseline_scores),\n",
        "        roc_auc_score(y_test, logreg_scores),\n",
        "        roc_auc_score(y_test, rf_scores),\n",
        "    ],\n",
        "    \"average_precision\": [\n",
        "        average_precision_score(y_test, baseline_scores),\n",
        "        average_precision_score(y_test, logreg_scores),\n",
        "        average_precision_score(y_test, rf_scores),\n",
        "    ],\n",
        "})\n",
        "\n",
        "results_display = results.copy()\n",
        "for c in [\"precision@50\", \"roc_auc\", \"average_precision\"]:\n",
        "    results_display[c] = results_display[c].round(3)\n",
        "\n",
        "print(f\"Train rows: {len(X_train):,} | clients: {groups.iloc[train_idx].nunique():,}\")\n",
        "print(f\"Test rows:  {len(X_test):,} | clients: {groups.iloc[test_idx].nunique():,}\")\n",
        "print(f\"Client overlap: {len(overlap)}\")\n",
        "print(f\"Test base rate: {y_test.mean():.3f}\")\n",
        "display(results_display)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "28b13494",
      "metadata": {
        "id": "28b13494"
      },
      "source": [
        "### Leakage audit\n",
        "\n",
        "W06 made the leakage test active rather than merely declarative. The experiment below deliberately adds `trend_pct`, which is label-derived, and verifies that the score jumps. A strong jump is the expected **failure signal**: it shows that the validation harness is sensitive to a known leak.\n",
        "\n",
        "The production feature set above never includes this column.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "79ac23a2",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "79ac23a2",
        "outputId": "8ecc3c76-d367-4218-e2da-da1f7a3cee0d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Honest Precision@50: 0.860\n",
            "Deliberately leaky Precision@50: 1.000\n",
            "Leak-induced jump: +0.140\n"
          ]
        }
      ],
      "source": [
        "# Deliberate leakage injection: trend_pct is a direct source of the proxy label.\n",
        "X_leaky = X.copy()\n",
        "X_leaky[\"trend_pct_LEAKY\"] = df[\"trend_pct\"].fillna(0)\n",
        "\n",
        "leaky_num_features = num_features + [\"trend_pct_LEAKY\"]\n",
        "preprocess_leaky = ColumnTransformer([\n",
        "    (\"num\", StandardScaler(), leaky_num_features),\n",
        "    (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), cat_features),\n",
        "])\n",
        "\n",
        "leaky_model = Pipeline([\n",
        "    (\"prep\", preprocess_leaky),\n",
        "    (\"clf\", LogisticRegression(max_iter=1000, random_state=42)),\n",
        "])\n",
        "\n",
        "leaky_model.fit(X_leaky.iloc[train_idx], y.iloc[train_idx])\n",
        "leaky_scores = leaky_model.predict_proba(X_leaky.iloc[test_idx])[:, 1]\n",
        "leaky_p50 = precision_at_k(leaky_scores, y.iloc[test_idx], K)\n",
        "\n",
        "honest_p50 = precision_at_k(logreg_scores, y_test, K)\n",
        "\n",
        "print(f\"Honest Precision@50: {honest_p50:.3f}\")\n",
        "print(f\"Deliberately leaky Precision@50: {leaky_p50:.3f}\")\n",
        "print(f\"Leak-induced jump: {leaky_p50 - honest_p50:+.3f}\")\n",
        "\n",
        "assert \"trend_pct\" not in (set(num_features + cat_features))\n"
      ]
    },
